{
  "name": "recruit-ai",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local-first startup hiring-partner research and review workspace.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalalune/recruit-ai.git"
  },
  "bugs": {
    "url": "https://github.com/lalalune/recruit-ai/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors magenta,cyan \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "bun --watch scripts/dev-api.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:binary": "bun run build && bun run scripts/run-with-retry.ts 3 bun run scripts/build-binaries.ts current",
    "build:binaries": "bun run build && bun run scripts/run-with-retry.ts 3 bun run scripts/build-binaries.ts all",
    "release:package": "bun run scripts/package-release.ts",
    "smoke:binary": "bun run scripts/smoke-binary.ts",
    "benchmark:10k": "bun run scripts/benchmark-10k.ts",
    "check": "bun run version:check && bun run typecheck && bun run test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test --timeout 60000",
    "test:coverage": "bun test --timeout 60000 --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "version:check": "bun run scripts/version-check.ts",
    "start": "bun src/server/index.ts"
  },
  "engines": {
    "bun": "1.3.14"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "cheerio": "^1.2.0",
    "hono": "^4.12.33",
    "lucide-react": "^1.28.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "robots-parser": "^3.0.1",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "bun-types": "^1.3.14",
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
