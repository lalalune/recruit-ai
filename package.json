{
  "name": "recruit-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Local-first startup hiring-partner research and review workspace.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lalalune/recruit-ai.git"
  },
  "bugs": {
    "url": "https://github.com/lalalune/recruit-ai/issues"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors magenta,cyan \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "RECRUITAI_DEV=1 bun --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "build:binary": "bun run build && bun run scripts/build-binaries.ts current",
    "build:binaries": "bun run build && bun run scripts/build-binaries.ts all",
    "benchmark:10k": "bun run scripts/benchmark-10k.ts",
    "check": "bun run typecheck && bun test && bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun src/server/index.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "cheerio": "^1.2.0",
    "date-fns": "^4.4.0",
    "hono": "^4.12.32",
    "lucide-react": "^1.27.0",
    "papaparse": "^5.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "robots-parser": "^3.0.1",
    "wouter": "^3.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "bun-types": "^1.3.14",
    "concurrently": "^10.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
